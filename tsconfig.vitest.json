{
  "extends": "./tsconfig.app.json",

  // Override to include only test files and clear exclusions.
  // Application code imported in tests is automatically included via module resolution.
  "include": [
    "src/**/*.test.*",
    "env.d.ts",
    "src/components/HelloWorld.test.ts",
    "src/components/work-in-progress.test.ts"
  ],
  "exclude": [],

  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.vitest.tsbuildinfo",

    // Component tests need the DOM lib inherited from the app config.
    "types": ["node", "happy-dom"]
  }
}
